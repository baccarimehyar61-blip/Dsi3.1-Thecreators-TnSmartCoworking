<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#EEEAE4"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUREAU"
            android:textColor="#168080"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Coworking Tunis"
            android:textColor="#263238"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvVille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tunis, Centre-ville"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/tvCapacite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capacité : 10 personnes"
            android:textColor="#455A64"
            android:textSize="14sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 DT / heure"
            android:textColor="#168080"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <!-- Management Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnModifier"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Modifier"
                android:textColor="#FFFFFF"
                android:backgroundTint="#168080" />

            <Button
                android:id="@+id/btnSupprimer"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Supprimer"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D9534F"
                android:layout_marginStart="10dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
