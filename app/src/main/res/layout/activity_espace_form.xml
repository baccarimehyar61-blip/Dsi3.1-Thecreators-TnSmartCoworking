<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modifier un espace"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#263238" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Veuillez remplir les informations de votre espace"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Name -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom de l'espace"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : Smart Coworking Tunis"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:layout_marginTop="6dp" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Décrivez votre espace..."
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginTop="6dp" />

        <!-- City -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ville"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etVille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : Tunis"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:layout_marginTop="6dp" />

        <!-- Address -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adresse"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etAdresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adresse complète"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:layout_marginTop="6dp" />

        <!-- Capacity -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capacité (personnes)"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etCapacite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 10"
            android:inputType="number"
            android:singleLine="true"
            android:layout_marginTop="6dp" />

        <!-- Price -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prix par heure (DT)"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 15.00"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:layout_marginTop="6dp" />

        <!-- Space type -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type d'espace"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <Spinner
            android:id="@+id/spType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <!-- Save button -->

        <Button
            android:id="@+id/btnSaveEspace"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Enregistrer les modifications"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#168080"
            android:layout_marginTop="30dp" />

        <!-- Cancel button -->

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Annuler"
            android:textColor="#455A64"
            android:backgroundTint="#E8E8E8"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>
